# ===== 主力模型（留空则自动进入本地 Demo 模式，无需任何 Key 即可完整体验） =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 多模态（扫描件简历 / 证书识别，可选） =====
GLM_API_KEY=
GLM_VISION_MODEL=glm-4v-flash

# ===== 检索（可选，留空则使用本地 BM25 检索） =====
SILICONFLOW_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# ===== 安全与限流 =====
MAX_INTERVIEW_TURNS=12
RATE_LIMIT_PER_SESSION=20
